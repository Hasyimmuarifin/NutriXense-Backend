# Runtime
NODE_ENV=production

# HiveMQ Cloud
MQTT_HOST=a8805b4f45744c3f9ac83882e423e0c0.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=replace_with_hivemq_username
MQTT_PASS=replace_with_hivemq_password
MQTT_TOPIC=nutrixense/sensor
MQTT_HISTORY_TOPIC=nutrixense/history
MQTT_CONTROL_TOPIC=nutrixense/control
MQTT_CLIENT_ID=nutrixense-backend

# Firebase Admin SDK
# Use either FIREBASE_SERVICE_ACCOUNT_PATH or FIREBASE_SERVICE_ACCOUNT.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=
FIRESTORE_COLLECTION=sensor_data
FIRESTORE_AUTOMATION_CONFIG_COLLECTION=automation_config
FIRESTORE_DSS_CONFIG_DOCUMENT=dss
FIRESTORE_WATERING_SCHEDULES_COLLECTION=watering_schedules
FIRESTORE_PUMP_LOGS_COLLECTION=pump_activity_logs
FIRESTORE_THRESHOLD_ALERT_LOGS_COLLECTION=threshold_alert_logs

# Optional settings
SAVE_INTERVAL_MS=60000
SAVE_REALTIME_SENSOR_TO_FIRESTORE=false
DSS_CHECK_INTERVAL_MS=600000
DSS_PULSE_DURATION_MS=5000
DSS_COOLDOWN_MS=600000
DSS_MAX_SENSOR_AGE_MS=600000
SCHEDULE_CHECK_INTERVAL_MS=15000
TIMEZONE_OFFSET_MINUTES=420
THRESHOLD_NOTIFICATION_ENABLED=true
FCM_ALERT_TOPIC=nutrixense_alerts
FCM_CHANNEL_ID=nutrixense_fcm_alerts